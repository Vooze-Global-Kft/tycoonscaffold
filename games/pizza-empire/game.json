  "story": [
    {
      "id": "intro",
      "characterId": "nonna",
      "title": "A Family Recipe",
      "trigger": {
        "type": "start"
      },
      "lines": [
        "Bambino! This little kitchen is all we have left.",
        "But my sauce? Mamma mia. It could feed the world.",
        "Tap the oven to bake. Then ring the bell so the waiter serves it!"
      ]
    },
    {
      "id": "first_chef",
      "characterId": "nonna",
      "title": "Many Hands",
      "trigger": {
        "type": "hired",
        "businessId": "margherita"
      },
      "lines": [
        "A real pizzaiolo! Look at them go.",
        "Now the oven never sleeps. And neither does the money."
      ],
      "rewardGems": 5
    },
    {
      "id": "meet_pepe",
      "characterId": "pepe",
      "title": "Pepe!",
      "trigger": {
        "type": "transportHired"
      },
      "lines": [
        "Ciao! I'm Pepe. Yes, I'm a pizza. No, you can't eat me.",
        "Your maître d' runs the floor now. Watch the counter: if dishes pile up, hire more waiters!",
        "And if a Golden Slice flies by, grab it. Fortune favours the fast."
      ],
      "rewardGems": 5
    },
    {
      "id": "second_station",
      "characterId": "pepe",
      "trigger": {
        "type": "owned",
        "businessId": "bruschetta",
        "count": 1
      },
      "lines": [
        "Two dishes on the menu! Fancy.",
        "Every station gets faster at level 10, 25 and 50. Keep feeding them."
      ],
      "rewardGems": 5
    },
    {
      "id": "rival_appears",
      "characterId": "rival",
      "title": "Competition",
      "trigger": {
        "type": "lifetimeEarnings",
        "amount": 250000
      },
      "lines": [
        "So you're the little kitchen everyone's talking about.",
        "Cute. I sell ten thousand frozen discs a day. FROZEN.",
        "Enjoy it while it lasts. Big Cheese Carl owns this town."
      ],
      "rewardGems": 10
    },
    {
      "id": "gelato",
      "characterId": "nonna",
      "title": "Dolce!",
      "trigger": {
        "type": "owned",
        "businessId": "gelato",
        "count": 1
      },
      "lines": [
        "Gelato! Now they stay for dessert.",
        "Two scoops. Always two. This is the law."
      ],
      "rewardGems": 10
    },
    {
      "id": "roma",
      "characterId": "nonna",
      "title": "Roma!",
      "trigger": {
        "type": "venue",
        "venueId": "roma"
      },
      "lines": [
        "A second restaurant. In ROMA!",
        "Nonna's Corner keeps earning while you build here. An empire, bambino!"
      ],
      "rewardGems": 15
    },
    {
      "id": "frozen_war",
      "characterId": "rival",
      "title": "Cold War",
      "trigger": {
        "type": "venue",
        "venueId": "venezia"
      },
      "lines": [
        "Venezia too? You're everywhere I look!",
        "This means war. Cheese war."
      ],
      "rewardGems": 15
    },
    {
      "id": "billionaire",
      "characterId": "nonna",
      "trigger": {
        "type": "lifetimeEarnings",
        "amount": 1000000000
      },
      "lines": [
        "A billion?! Your nonno would be so proud.",
        "When you're ready, franchise the empire and earn Chef Stars."
      ],
      "rewardGems": 20
    },
    {
      "id": "first_franchise",
      "characterId": "rival",
      "title": "Round Two",
      "trigger": {
        "type": "prestige",
        "count": 1
      },
      "lines": [
        "You sold it all... and came back STRONGER?",
        "Fine. Round two, pizza kid."
      ],
      "rewardGems": 25
    },
    {
      "id": "moon",
      "characterId": "pepe",
      "title": "One Small Slice",
      "trigger": {
        "type": "venue",
        "venueId": "moon"
      },
      "lines": [
        "We put an oven. On the MOON.",
        "The crust is out of this world. I'll see myself out."
      ],
      "rewardGems": 30
    },
    {
      "id": "planet",
      "characterId": "rival",
      "title": "Checkmate",
      "trigger": {
        "type": "venue",
        "venueId": "planet"
      },
      "lines": [
        "A planet. You bought a PLANET.",
        "...Is it hiring?"
      ],
      "rewardGems": 50
    }
  ],
