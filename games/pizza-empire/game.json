  "story": [
    {
      "id": "intro",
      "characterId": "nonna",
      "title": "A Family Recipe",
      "trigger": {
        "type": "start"
      },
      "lines": [
        "Bambino! This old slice stand is all we have left.",
        "But my sauce? Mamma mia. It could feed the world.",
        "Tap the pizza to toss the dough. Toss fast and the frenzy begins!"
      ]
    },
    {
      "id": "meet_pepe",
      "characterId": "pepe",
      "title": "Pepe!",
      "trigger": {
        "type": "owned",
        "businessId": "slice_stand",
        "count": 5
      },
      "lines": [
        "Ciao! I'm Pepe. Yes, I'm a pizza. No, you can't eat me.",
        "See a Golden Slice fly by? Grab it! They're worth a fortune."
      ],
      "rewardGems": 5
    },
    {
      "id": "first_truck",
      "characterId": "nonna",
      "trigger": {
        "type": "owned",
        "businessId": "food_truck",
        "count": 1
      },
      "lines": [
        "A truck! Now the whole city can taste my sauce.",
        "Hire a chef so the ovens keep running while you nap."
      ],
      "rewardGems": 5
    },
    {
      "id": "first_pizzeria",
      "characterId": "pepe",
      "trigger": {
        "type": "owned",
        "businessId": "pizzeria",
        "count": 1
      },
      "lines": [
        "A real pizzeria! With chairs! And a roof!",
        "Own 10, 25, 50 of anything and it gets faster. Collect them all!"
      ],
      "rewardGems": 5
    },
    {
      "id": "rival_appears",
      "characterId": "rival",
      "title": "Competition",
      "trigger": {
        "type": "lifetimeEarnings",
        "amount": 1000000
      },
      "lines": [
        "So you're the little pizza shop everyone's talking about.",
        "Cute. I sell ten thousand frozen discs a day. FROZEN.",
        "Enjoy it while it lasts. Big Cheese Carl owns this town."
      ],
      "rewardGems": 10
    },
    {
      "id": "frozen_war",
      "characterId": "rival",
      "title": "Cold War",
      "trigger": {
        "type": "owned",
        "businessId": "frozen",
        "count": 1
      },
      "lines": [
        "You're making FROZEN pizza now? That's MY thing!",
        "This means war. Cheese war."
      ],
      "rewardGems": 10
    },
    {
      "id": "tv_star",
      "characterId": "nonna",
      "title": "Prime Time",
      "trigger": {
        "type": "owned",
        "businessId": "tv_show",
        "count": 1
      },
      "lines": [
        "I'm on the television! Do I look okay? Is my bun straight?",
        "Hello, world. This is how you make a REAL pizza."
      ],
      "rewardGems": 15
    },
    {
      "id": "billionaire",
      "characterId": "nonna",
      "trigger": {
        "type": "lifetimeEarnings",
        "amount": 1000000000
      },
      "lines": [
        "A billion?! Your nonno would be so proud.",
        "When you're ready, franchise the empire and earn Chef Stars."
      ],
      "rewardGems": 20
    },
    {
      "id": "moon",
      "characterId": "pepe",
      "title": "One Small Slice",
      "trigger": {
        "type": "owned",
        "businessId": "moon_oven",
        "count": 1
      },
      "lines": [
        "We put an oven. On the MOON.",
        "The crust is out of this world. I'll see myself out."
      ],
      "rewardGems": 20
    },
    {
      "id": "first_franchise",
      "characterId": "rival",
      "title": "Round Two",
      "trigger": {
        "type": "prestige",
        "count": 1
      },
      "lines": [
        "You sold it all... and came back STRONGER?",
        "Fine. Round two, pizza kid."
      ],
      "rewardGems": 25
    },
    {
      "id": "planet",
      "characterId": "rival",
      "title": "Checkmate",
      "trigger": {
        "type": "owned",
        "businessId": "pizza_planet",
        "count": 1
      },
      "lines": [
        "A planet. You bought a PLANET.",
        "...Is it hiring?"
      ],
      "rewardGems": 50
    }
