  "story": [
    {
      "id": "intro",
      "characterId": "ai",
      "title": "Boot Sequence",
      "trigger": {
        "type": "start"
      },
      "lines": [
        "Good morning, Miner. Your company owns one drill and a lot of debt.",
        "Tap the drill to dig out ore. I will handle the paperwork."
      ]
    },
    {
      "id": "first_pilot",
      "characterId": "ai",
      "trigger": {
        "type": "hired",
        "businessId": "drill"
      },
      "lines": [
        "Unit D-1 is online. The drill now runs without you.",
        "Every machine can have a pilot. Pilots never take a lunch break."
      ],
      "rewardGems": 5
    },
    {
      "id": "refinery",
      "characterId": "ai",
      "trigger": {
        "type": "owned",
        "businessId": "refinery",
        "count": 1
      },
      "lines": [
        "A refinery! Raw rock is cheap. Shiny metal is not.",
        "Every machine runs twice as fast at 15 and 40 units. Keep building."
      ],
      "rewardGems": 5
    },
    {
      "id": "rival",
      "characterId": "rival",
      "title": "A Visitor",
      "trigger": {
        "type": "lifetimeEarnings",
        "amount": 2000000.0
      },
      "lines": [
        "Director Rook, Consolidated Rocks. We own this sector. Mostly.",
        "Sell me your little operation now, while it is still little."
      ],
      "rewardGems": 10
    },
    {
      "id": "moon",
      "characterId": "ai",
      "title": "Base Camp",
      "trigger": {
        "type": "owned",
        "businessId": "moon_base",
        "count": 1
      },
      "lines": [
        "We have a base on the Moon. Commander Vega sends her regards.",
        "Director Rook sends a strongly worded memo."
      ],
      "rewardGems": 10
    },
    {
      "id": "array",
      "characterId": "rival",
      "title": "Show-off",
      "trigger": {
        "type": "owned",
        "businessId": "sun_array",
        "count": 1
      },
      "lines": [
        "Mirrors around a star? That is... actually rather clever.",
        "This is not over, Miner."
      ],
      "rewardGems": 15
    },
    {
      "id": "first_jump",
      "characterId": "ai",
      "title": "New Galaxy",
      "trigger": {
        "type": "prestige",
        "count": 1
      },
      "lines": [
        "Jump complete. New galaxy, same debt-free you.",
        "Every Warp Core adds 25% to everything we make."
      ],
      "rewardGems": 20
    }
  ],
